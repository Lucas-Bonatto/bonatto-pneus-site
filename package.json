{
  "name": "bonatto-pneus-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --configLoader runner && node scripts/prepare-production-build.mjs",
    "preview": "vite preview",
    "preview:edge": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "test": "node --test tests/production-build.test.mjs",
    "check": "npm run build && npm test",
    "security:check": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "vite": "8.2.2"
  },
  "devDependencies": {
    "wrangler": "4.128.0"
  }
}
